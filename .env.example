# ---------------------------------------------------------------------------
# JustDial Mailer - configuration
# Copy this file to ".env" and fill in your values.
# ---------------------------------------------------------------------------

# --- HTTP server -----------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# The path JustDial will POST/GET the lead to.
ENDPOINT_PATH=/justdial/lead

# Optional but recommended: a secret appended to the path so nobody else can
# spam your inbox. Leave empty for no secret.
# With PATH_SECRET=abc123xyz the URL becomes: /justdial/lead/abc123xyz
PATH_SECRET=

# Health check path.
HEALTH_PATH=/health

# --- Gmail SMTP ------------------------------------------------------------
# Use a Google "App Password" (16 characters, no spaces).
# Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# --- Email -----------------------------------------------------------------
# Sender (usually the same as SMTP_USER for Gmail).
MAIL_FROM=your-gmail-address@gmail.com
MAIL_FROM_NAME=JustDial Leads

# Who receives the lead emails. Comma separate for multiple people.
MAIL_TO=owner@yourcompany.com, sales@yourcompany.com

# Optional CC.
MAIL_CC=

# Subject template. Placeholders: {{name}} {{mobile}} {{company}} {{city}}
#                              {{category}} {{leadid}}
MAIL_SUBJECT=New JustDial Lead: {{name}} ({{mobile}})

# --- Behaviour -------------------------------------------------------------
# true  = do not actually send email, just print it to the console/log.
#         Useful for testing before you have SMTP working.
DRY_RUN=false

# JustDial retries a call when it does not get a reply fast enough. Set this to
# e.g. 30 to ignore the same lead id arriving again within 30 seconds (so you
# do not get duplicate emails). 0 = email on every single call.
DEDUPE_WINDOW_SECONDS=0

# Retry a failed email every N seconds (0 = never).
RETRY_INTERVAL_SECONDS=300

# Give up on a failed email after N attempts.
MAX_SEND_ATTEMPTS=10

# Where logs and unsent leads are stored (relative to the project folder).
LOG_DIR=logs

# Timezone used for the "Received ..." stamp in the email.
TIMEZONE=Asia/Kolkata

# --- Email copy buttons ----------------------------------------------------
# The "Copy" buttons in the email open a small page under your public URL.
# Leave PUBLIC_URL empty and it is taken from the request that delivered the
# lead - correct behind nginx/Cloudflare with no configuration. Set it only if
# the auto-detected host is wrong (e.g. you are behind a port forward).
PUBLIC_URL=

# Path of the copy page.
COPY_PATH=/copy

# A bare 10 digit number gets this country code for Call / WhatsApp (India = 91).
DEFAULT_COUNTRY_CODE=91

# Pre-filled WhatsApp message for the "WhatsApp" BUTTON in the email.
WHATSAPP_GREETING=Hello {{name}}, thank you for your enquiry on JustDial. How can we help you?


# ===========================================================================
# SENDING THE LEAD TO WHATSAPP
# ===========================================================================
# Off by default. Nothing is ever sent to WhatsApp until WHATSAPP_ENABLED=true.
WHATSAPP_ENABLED=false

# openwa  = the @open-wa/wa-automate library runs inside this service. You link
#           it to your own WhatsApp once by scanning a QR code, and it then
#           sends from that number.
# webhook = the message is POSTed as JSON to any WhatsApp HTTP gateway
#           (WAHA, n8n, Make, your own bot). Nothing extra to install.
WHATSAPP_PROVIDER=openwa

# --- provider: webhook -----------------------------------------------------
# Receives {"chatId":"919876543210@c.us","phone":"919876543210","message":"..."}
# with an "Authorization: Bearer <token>" header when a token is set.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# --- provider: openwa ------------------------------------------------------
# Where the WhatsApp login is remembered. Keep this folder PRIVATE: whoever
# holds it holds your WhatsApp session. It is in .gitignore already.
WHATSAPP_SESSION_ID=justdial-mailer
WHATSAPP_SESSION_DIR=.wa-session

# false = a WhatsApp window opens on the server (only useful on a desktop).
WHATSAPP_HEADLESS=true

# Only needed when Chrome is somewhere unusual.
WHATSAPP_CHROME_PATH=

# How long a send waits for the client to come up before the retry loop takes
# over. The first run needs a QR scan, so give it time.
WHATSAPP_START_TIMEOUT_SECONDS=120

# Extra open-wa options as JSON, merged last. Escape hatch, usually empty.
WHATSAPP_OPENWA_OPTIONS=

# --- who gets the message --------------------------------------------------
# Send it to the lead's own number, the one JustDial gave us.
WHATSAPP_SEND_TO_LEAD=true
# Also send a copy to these numbers - your sales team. Comma separated.
WHATSAPP_TEAM_NUMBERS=
# Never message these. Full number, or just the last few digits.
WHATSAPP_BLOCKLIST=
# Skip numbers JustDial flagged as DNC. Strongly recommended: leave it true.
WHATSAPP_RESPECT_DNC=true

# --- the message -----------------------------------------------------------
# Shown in the message as {{business}}.
BUSINESS_NAME=Your Business Name

# Placeholders: {{name}} {{fullname}} {{mobile}} {{phone}} {{email}} {{company}}
#               {{category}} {{city}} {{area}} {{address}} {{pincode}}
#               {{leadtype}} {{leadid}} {{date}} {{time}} {{business}}
# Leave WHATSAPP_MESSAGE unset to use the built-in Hinglish default.
WHATSAPP_MESSAGE="Namaste {{name}} ji,\n\nAapne JustDial par enquiry ki thi ({{category}}).\nHum aapki puri madad kar sakte hain.\n\nKya hum aapko ek call kar sakte hain?\n\n- {{business}}"

# --- pacing (WhatsApp dislikes bursts) -------------------------------------
# A random pause between two messages to different numbers.
WHATSAPP_MIN_DELAY_SECONDS=5
WHATSAPP_MAX_DELAY_SECONDS=15
# Give up on a message after this many attempts.
WHATSAPP_MAX_ATTEMPTS=5
